# ── Session feeder — environment configuration ───────────────────────────
# Copy this file to .env and adjust values for your deployment.

# One component, one code path: x86 CI/dev and the
# Jetson differ only by which values are configured here, never by a code
# branch. The ingestion mode is derived from
# REPLAY_DEPLOYMENT_PROFILE — it is never set directly.
# ─────────────────────────────────────────────────────────────────────────────

# ── Deployment profile ──────────────────────────────────────────────────────
# cloud -> HTTP-upload mode (crosses the network by definition)
# x86_ci -> HTTP-upload mode (mirrors the cloud path for CI/dev smoke)
# mixed -> path-registration mode (feeder and inference service both on the Jetson)
# edge -> path-registration mode (same as mixed — everything on the Jetson)
# auto -> a link probe measures real uplink throughput at session start and
# resolves EXACTLY ONE of {cloud, mixed, edge} for that session
# — see "Auto profile / link probe" below.
REPLAY_DEPLOYMENT_PROFILE=x86_ci
REPLAY_LOG_LEVEL=info

# ── Local image store ────────────────────────────────
# The root of the session folders (sessions/<session_id>/manifest.json + images/), mounted into the container.
REPLAY_DATA_ROOT=/app/data
REPLAY_MANIFEST_FILENAME=manifest.json
REPLAY_MARKER_FILENAME=.replayed.json
# Explicit session id override — leave unset for the
# default oldest-not-yet-replayed selection.
REPLAY_SESSION_ID=

# ── Session-level default location ──────────────────────────────────────────
# Deployment-configured default location of the sessions,
# forwarded as the session's own latitude/longitude. Distinct from
# per-image position passthrough, which is read from each
# session's own manifest, never defaulted.
REPLAY_DEFAULT_LATITUDE=
REPLAY_DEFAULT_LONGITUDE=

# ── Inference service target ─────────────────────────────────────────────
REPLAY_INFERENCE_BASE_URL=http://inference:8010
# Pre-shared API key (must match INFERENCE_EXTERNAL_API_KEY on the inference service side).
REPLAY_INFERENCE_API_KEY=
# Path-registration mode only: set when the feeder's own view of data_root
# differs from the inference service's view of the same shared mount (identity if unset).
REPLAY_INFERENCE_VISIBLE_DATA_ROOT=

# ── Auto profile / link probe ───────────────────────
# Only read when REPLAY_DEPLOYMENT_PROFILE=auto. The cloud scenario submits
# to the REMOTE inference service while mixed/edge submit to the
# Jetson-LOCAL one (REPLAY_INFERENCE_BASE_URL above), so auto mode needs its
# own dedicated cloud target — the probe and any auto-resolved cloud
# submission use it; auto-resolved mixed/edge keep using
# REPLAY_INFERENCE_BASE_URL. `auto` is REFUSED at startup without this URL
# set (fail-closed configuration).
REPLAY_CLOUD_INFERENCE_BASE_URL=
# Pre-shared API key for the cloud target. Defaults to
# REPLAY_INFERENCE_API_KEY when unset.
REPLAY_CLOUD_INFERENCE_API_KEY=
# Number of timed upload samples the probe takes; the median decides.
REPLAY_PROBE_SAMPLES=3
# Bytes of the deterministic payload of the probe's first payload upload (a ramp
# reading until an upload lasts the floor; the first sample is the settling one). The
# probe measures the round trip with a 1-byte upload, then doubles the payload
# from this size until one upload lasts REPLAY_PROBE_MIN_SAMPLE_SECONDS.
REPLAY_PROBE_PAYLOAD_BYTES=32768
# Seconds one sample upload must last so the transfer, not the round trip,
# dominates it; each sample is bytes over elapsed minus the round trip. 0
# switches the round-trip upload, the ramp and the correction off.
REPLAY_PROBE_MIN_SAMPLE_SECONDS=1.0
# Largest payload the ramp uploads. Bound by the probe sink's cap
# (INFERENCE_PROBE_SINK_MAX_BYTES, default 1048576): a ramp step the sink
# refuses as too large settles the size one step below.
REPLAY_PROBE_MAX_PAYLOAD_BYTES=1048576
# Per-sample upload timeout in seconds: a per-operation stall bound, not a
# total per-sample deadline -- a slow-but-alive link still measures; the
# first timeout short-circuits the probe.
REPLAY_PROBE_TIMEOUT_SECONDS=45
# Thresholds (fixed in app/selector.py, not configurable):
# uplink >= 5 Mbps (5000 kbps) selects Cloud -- the boundary belongs to
# Cloud. Any successfully measured uplink below 5 Mbps selects Mixed,
# whatever its value. Edge is never selected by a measured value; it is
# selected exclusively by probe failure (refusal, timeout, non-2xx, zero
# samples), with the failure reason recorded alongside the decision.

REPLAY_TLS_VERIFY=true
# Session-upload timeouts: a moving upload is never aborted for
# duration, only for a lack of progress. REPLAY_UPLOAD_STALL_SECONDS bounds
# how long a single transport write may sit without progress before the
# upload is declared dead (error marker `upload-stalled`).
# REPLAY_RESPONSE_WAIT_SECONDS bounds how long to await the service's answer
# after the body is fully sent, sized for inline detection of a full session
# (error marker `response-timeout`). REPLAY_REQUEST_TIMEOUT_SECONDS is
# deprecated but still honored as the fallback for whichever of the two new
# keys is left unset (a startup log line names the deprecation when set).
REPLAY_UPLOAD_STALL_SECONDS=60
REPLAY_RESPONSE_WAIT_SECONDS=300
REPLAY_REQUEST_TIMEOUT_SECONDS=
REPLAY_AUTO_PUSH=true
REPLAY_PARCEL_ID=parcel-001

# Optional output files: the push result, and a mirror of the accounting record.
REPLAY_RESULT_FILE=
REPLAY_ACCOUNTING_FILE=
# Set to a directory to record every outbound connection attempt.
CONN_AUDIT_LOG_DIR=
