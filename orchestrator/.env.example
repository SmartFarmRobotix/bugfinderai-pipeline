# the session orchestrator example environment

APP_NAME=SessionOrchestrator
ENVIRONMENT=development
LOG_LEVEL=info

ORCH_SERVICE_HOST=0.0.0.0
ORCH_SERVICE_PORT=8020
# The name this service registers itself under with GateKeeper
# (gk_registration.py) -- must match this compose service's own name
# ("orchestrator") for the base_url other services reach it at to resolve.
ORCH_SERVICE_NAME=orchestrator

ORCH_DATABASE_URL=sqlite:////code/app/data/orchestrator.db
ORCH_MAX_OUTBOUND_RETRIES=3

# selects the intake endpoint's auth
# mechanism. cloud|mixed require the Gatekeeper credentials below; edge
# requires ORCH_EDGE_SHARED_SECRET instead and must never be configured
# with Gatekeeper credentials as a startup dependency.
ORCH_DEPLOYMENT_PROFILE=cloud

# Edge-local shared secret, presented by the on-device inference
# component as the X-Edge-Shared-Secret header. Only required (and
# checked against known placeholder values) when ORCH_DEPLOYMENT_PROFILE=edge. Never
# distributed to or shared with the Gatekeeper, the Reporting, PDM and Weather services.
ORCH_EDGE_SHARED_SECRET=

# Gatekeeper integration. No defaults for the credentials: the service refuses to start without them.
# The base URL is the Gatekeeper's address as seen from this container.
ORCH_GATEKEEPER_BASE_URL=http://gatekeeper:8001
ORCH_GATEKEEPER_USERNAME=
ORCH_GATEKEEPER_PASSWORD=
ORCH_GATEKEEPER_TOKEN_ENDPOINT=/api/login/
ORCH_GATEKEEPER_TIMEOUT_SECONDS=10
# The path the Gatekeeper exposes for validating a caller-presented intake token.
ORCH_GATEKEEPER_VALIDATE_PATH=/api/validate_token/

# PDM's scalar-only rule-assessment endpoint, reached through GateKeeper's proxy.
ORCH_PDM_SERVICE_NAME=pdm
ORCH_PDM_RISK_ASSESSMENT_PATH=/api/v1/risk-assessment/
ORCH_PDM_CALL_TIMEOUT_SECONDS=15

# The Reporting service's pest-session-report endpoint, reached through the Gatekeeper's proxy.
ORCH_RS_SERVICE_NAME=reporting
ORCH_RS_PEST_SESSION_REPORT_PATH=/api/v1/openagri-report/pest-session-report/
ORCH_RS_CALL_TIMEOUT_SECONDS=15

# Weather service (the fuzzy path's history and forecast fetches, through the Gatekeeper's proxy).
ORCH_WS_SERVICE_NAME=weather_data

# Edge profile: the local report directory, the on-device inference service and the sync queue.
ORCH_EDGE_REPORT_DIR=/code/app/data/reports
ORCH_EDGE_INFERENCE_BASE_URL=http://inference:8010
ORCH_EDGE_INFERENCE_API_KEY=
ORCH_SYNC_QUEUE_DIR=/code/app/sync_queue
# Synchronisation of the queue to the cloud (python sync_worker.py): the cloud Gatekeeper account.
ORCH_SYNC_GATEKEEPER_USERNAME=
ORCH_SYNC_GATEKEEPER_PASSWORD=
ORCH_SYNC_REASSESS_ENABLED=true

# The site label printed on the report when the session carries no better one.
ORCH_REPORT_SITE_LABEL=Field site

# Edge housekeeping and the fusion rule (defaults shown).
EDGE_DISK_BUDGET_PCT=80
EDGE_HOUSEKEEPING_INTERVAL_SEC=300
ORCH_FUSION_RULE_VERSION=v1
# Set to a directory to record every outbound connection attempt (deploy/edge/compose.yml sets it).
CONN_AUDIT_LOG_DIR=
