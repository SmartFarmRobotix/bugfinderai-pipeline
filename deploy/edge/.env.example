# Robot, Edge scenario. Copy to .env beside compose.yml.

# The pre-shared key between the feeder, the orchestrator and the inference service. REQUIRED.
INFERENCE_EXTERNAL_API_KEY=
# The secret the inference service presents to the orchestrator's intake. REQUIRED, not a placeholder.
EDGE_SHARED_SECRET=
# The directory with the session folders (sessions/<id>/manifest.json + images/).
DATA_DIR=./data
# The model directory: model.engine (Jetson) or model.onnx (cpu), the provenance file and designation-manifest.json.
MODEL_DIR=./model
OUT_DIR=./out
SESSION_LATITUDE=
SESSION_LONGITUDE=
SESSION_PARCEL_ID=parcel-001

# Synchronisation of the queued reports to the cloud (profile "sync"): the cloud Gatekeeper and an account.
CLOUD_GATEKEEPER_URL=
SYNC_GK_USERNAME=
SYNC_GK_PASSWORD=
# After the upload the cloud orchestrator re-assesses the session with weather data (true) or not (false).
SYNC_REASSESS=true
