# Robot, Mixed scenario. Copy to .env beside compose.yml.

# The cloud Gatekeeper and the account the robot logs in with. REQUIRED.
GATEKEEPER_URL=
GK_USERNAME=
GK_PASSWORD=
# The pre-shared key between the feeder and the inference service on the device. REQUIRED.
INFERENCE_EXTERNAL_API_KEY=
# The directory with the session folders (sessions/<id>/manifest.json + images/), shared by both containers.
DATA_DIR=./data
# The model directory: model.engine (Jetson) or model.onnx (cpu), the provenance file and designation-manifest.json.
MODEL_DIR=./model
OUT_DIR=./out

# Feeder: "auto" probes the uplink and selects Cloud, Mixed or Edge per session; "mixed" submits on the device.
FEEDER_PROFILE=auto
# The cloud inference service, needed by "auto" for the probe and for a Cloud submission.
CLOUD_INFERENCE_URL=
CLOUD_INFERENCE_API_KEY=
SESSION_LATITUDE=
SESSION_LONGITUDE=
SESSION_PARCEL_ID=parcel-001
INFERENCE_HOST_PORT=8011
