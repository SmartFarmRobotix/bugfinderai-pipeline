# Cloud host. Copy to .env beside compose.yml and compose.inference.yml. Values marked REQUIRED have no default.

# Shared secrets. REQUIRED. Placeholders such as "change-me" are refused by the services.
JWT_SIGNING_KEY=
DJANGO_SECRET_KEY=

# The Gatekeeper account every service logs in with.
GK_SUPERUSER_USERNAME=admin
GK_SUPERUSER_EMAIL=admin@example.com
# REQUIRED
GK_SUPERUSER_PASSWORD=
# Host names or addresses the Gatekeeper accepts requests for (append the public address of this host).
GK_EXTRA_ALLOWED_HOSTS=gatekeeper

# Databases. REQUIRED passwords.
GK_MYSQL_ROOT_PASSWORD=
GK_MYSQL_PASSWORD=
PDM_POSTGRES_PASSWORD=
WEATHER_MONGO_ROOT_PASSWORD=
REPORTING_POSTGRES_PASSWORD=

# Images of the four OpenAgri services. Empty: compose builds them from the forks under ../services/ (git
# submodules, branch sip12). Set a name to use an image built elsewhere from the same branch.
GK_IMAGE=
PDM_IMAGE=
WEATHER_IMAGE=
REPORTING_IMAGE=

# Optional weather provider key; unset disables that provider.
WEATHER_SRV_OPENWEATHERMAP_API_KEY=
# The Gatekeeper user id (UUID) that owns the reports synchronised from edge devices; empty keeps the uploader.
REPORTING_EDGE_REPORT_OWNER_USER_ID=

# Inference (compose.inference.yml). REQUIRED: the pre-shared key the feeder presents, and the model directory.
INFERENCE_EXTERNAL_API_KEY=
INFERENCE_MODEL_DIR=./model
INFERENCE_TILE_BATCH=4

# Feeder (profile "feeder"): the directory that holds sessions/<id>/ (manifest.json + images/), and where the
# result files go.
SESSIONS_DIR=./data
OUT_DIR=./out
SESSION_LATITUDE=
SESSION_LONGITUDE=
SESSION_PARCEL_ID=parcel-001

# Published ports.
GK_HOST_PORT=8001
PDM_HOST_PORT=8003
REPORTING_HOST_PORT=8009
WEATHER_HOST_PORT=8010
INFERENCE_HOST_PORT=8011
ORCH_HOST_PORT=8021
